{
  "name": "gif-masher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Combine multiple GIFs into one animated GIF, in the exact order you add them.",
  "license": "MIT",
  "author": "GIF Masher contributors",
  "homepage": "https://github.com/Grobbit/GIF-masher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grobbit/GIF-masher.git"
  },
  "bugs": {
    "url": "https://github.com/Grobbit/GIF-masher/issues"
  },
  "keywords": [
    "gif",
    "combine",
    "merge",
    "concatenate",
    "animation",
    "gifenc",
    "gifuct",
    "react",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "gif-masher": "dist/cli/gif-masher.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:cli": "node scripts/build-cli.mjs",
    "build:all": "npm run build && npm run build:cli",
    "cli": "node dist/cli/gif-masher.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
